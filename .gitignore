# Agent configs / private notes — never tracked in this repo
# `.agents` is deliberately slashless: it is usually a symlink, which a
# directory-only `.agents/` pattern would not match.
# `*.local.*` covers every extension, not just `.local.md`.
.agents
*.local.*
CLAUDE*
.claude/

# Virtualenvs
.venv*/
venv/
env/
.env/

# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Test / coverage / type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
site/
